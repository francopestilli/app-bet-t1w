{
  "name": "app-bet-t1w",
  "github": "gamorosino/app-bet-t1w",
  "github_branch": "main",
  "desc": "Skull-strip a T1w MRI with FSL BET",
  "config": {
    "t1": {
      "type": "input",
      "file_id": "t1",
      "input_id": "t1"
    },
    "frac": {
      "id": "frac",
      "type": "number",
      "default": 0.5,
      "desc": "BET fractional intensity threshold (0-1)"
    },
    "robust": {
      "id": "robust",
      "type": "boolean",
      "default": false,
      "desc": "Use robust brain centre estimation (-R)"
    },
    "bias_neck_cleanup": {
      "id": "bias_neck_cleanup",
      "type": "boolean",
      "default": false,
      "desc": "Bias field + neck cleanup (-B)"
    }
  },
  "inputs": [
    {
      "id": "t1",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "optional": false,
      "multi": false,
      "advanced": false
    }
  ],
  "outputs": [
    {
      "id": "t1_brain",
      "desc": "Skull-stripped T1w brain volume produced by FSL BET",
      "datatype": "neuro/anat/t1w",
      "datatype_tags": [],
      "archive": true
    }
  ]
}
